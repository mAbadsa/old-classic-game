# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required — JwtStrategy throws at startup if unset. Use a long random string,
# e.g. `openssl rand -base64 48`.
JWT_SECRET="change-me"
# Token lifetime (ms-style string). Defaults to 24h if unset.
JWT_EXPIRATION="24h"

# The frontend dev server already uses 3000, so run the API on 3001
# (matches the frontend's NEXT_PUBLIC_API_URL default).
PORT=3001

# Comma-separated list of origins allowed to call this API cross-origin.
# Defaults to the frontend's dev origin (http://localhost:3000) if unset.
CORS_ORIGIN="http://localhost:3000"

# This server's own externally-reachable base URL — used to build fetchable
# URLs for locally-stored uploads (see uploads/storage/local-storage.provider.ts).
APP_URL="http://localhost:3001"

# Where ROM uploads are written when STORAGE_DRIVER=local (the default).
# Point this at a mounted Docker volume in production-like setups, e.g.
# `-v roms:/data/roms` with UPLOADS_DIR=/data/roms.
UPLOADS_DIR="./uploads/roms"

# Where GET /games/:gameId/rom looks for a game's ROM file, named
# <gameId><extension> (extension derived from the game's `emulator`, see
# games/rom-file.util.ts). Distinct from UPLOADS_DIR above.
ROMS_DIR="./public/roms"

# "local" (default) writes to UPLOADS_DIR on this filesystem/volume.
# "s3" uploads to AWS S3 instead — requires AWS_S3_BUCKET and AWS_REGION below;
# credentials resolve through the AWS SDK's default provider chain.
STORAGE_DRIVER="local"
# AWS_S3_BUCKET="your-bucket-name"
# AWS_REGION="us-east-1"
