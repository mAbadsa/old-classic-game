{
  "name": "old-classic-game",
  "version": "0.1.0",
  "private": true,
  "description": "Classic game emulator web app monorepo (Next.js frontend + NestJS backend)",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,magenta \"npm run dev -w apps/frontend\" \"npm run dev -w apps/backend\"",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:backend": "npm run dev -w apps/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
